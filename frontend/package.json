{
  "name": "papi-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest",
    "gen:api": "uv run --project .. papi web openapi --out src/api/openapi.json && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "gen:api:local": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "7.0.8",
    "@tanstack/react-query": "5.108.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "i18next": "27.2.3",
    "lightweight-charts": "5.3.0",
    "lucide-react": "1.77.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
