{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyst/1",
  "title": "papi analyst output v1",
  "description": "Structured output of the analyst call (PRD 04 §4.1). Unknown values are null, never guessed. Span ordinals refer to the [S<n>] markers of the context pack; citation ids refer to the KB provisions listed in the pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_codes",
    "payload",
    "payload_spans",
    "fundamental_channels",
    "fundamental_direction",
    "materiality",
    "materiality_rationale",
    "claims",
    "summary_tr",
    "summary_en",
    "headline_tr",
    "watch_next",
    "confidence"
  ],
  "properties": {
    "event_codes": {
      "type": "array",
      "description": "Event codes that apply to the disclosure (confirm the rules codes or override with taxonomy codes from the pack).",
      "minItems": 1,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"}
    },
    "payload": {
      "type": "object",
      "description": "Per event code: the payload object following that code's payload schema from the pack (null fields when unknown).",
      "additionalProperties": {"type": ["object", "null"]}
    },
    "payload_spans": {
      "type": "object",
      "description": "Per event code: {dotted field path: [span ordinals the value was read from]}.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "fundamental_channels": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "revenue",
          "profitability",
          "costs",
          "balance_sheet",
          "financing",
          "dilution",
          "shareholder_return",
          "ownership_control",
          "governance",
          "legal_regulatory",
          "operations_capacity",
          "market_liquidity",
          "none"
        ]
      }
    },
    "fundamental_direction": {"type": "string", "enum": ["positive", "negative", "mixed", "unclear"]},
    "materiality": {"type": "integer", "minimum": 0, "maximum": 100},
    "materiality_rationale": {"type": "string", "maxLength": 1200},
    "claims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text_tr", "text_en", "span_ordinals", "citation_ids", "value", "unit", "formula_id"],
        "properties": {
          "kind": {"type": "string", "enum": ["fact", "computation", "inference"]},
          "text_tr": {"type": "string", "minLength": 1, "maxLength": 600},
          "text_en": {"type": ["string", "null"], "maxLength": 600},
          "span_ordinals": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "citation_ids": {"type": "array", "items": {"type": "string"}},
          "value": {"type": ["string", "null"], "maxLength": 64},
          "unit": {"type": ["string", "null"], "maxLength": 32},
          "formula_id": {
            "type": ["string", "null"],
            "enum": ["sum", "difference", "ratio", "percent_of", "percent_change", "product", null]
          }
        }
      }
    },
    "summary_tr": {"type": "string", "minLength": 1, "maxLength": 1500},
    "summary_en": {"type": "string", "minLength": 1, "maxLength": 1500},
    "headline_tr": {"type": "string", "minLength": 1, "maxLength": 200},
    "watch_next": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 300}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
