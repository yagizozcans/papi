{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.report.financial.guidance/1",
  "title": "event.report.financial.guidance payload v1",
  "description": "Forward-looking statements (geleceğe dönük değerlendirmeler). Unknown = null; spans are kept outside the payload (event.extra.payload_spans).",
  "type": "object",
  "required": [
    "period_year",
    "currency",
    "metrics"
  ],
  "properties": {
    "period_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "metrics": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "low": {
            "type": [
              "number",
              "null"
            ]
          },
          "high": {
            "type": [
              "number",
              "null"
            ]
          },
          "point": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
